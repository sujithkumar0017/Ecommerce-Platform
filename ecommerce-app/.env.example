# ShopKart E-Commerce App (ecommerce-app) — port 3000
# Copy this file to .env and fill in real values. .env is gitignored.

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (Postgres) ---
# Must point to the SAME database/instance as admin-app's .env
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopkart
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:@localhost:5432/shopkart

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Client / CORS ---
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
